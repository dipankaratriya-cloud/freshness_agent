# Copy this file to .env and fill in real values. Never commit .env itself.

# Required — Tier 1 (Gemini computer-use), Tier 2's pi coding agent, and the
# import-time client construction in computer_use_extractor.py all need this.
GEMINI_API_KEY=

# Optional — importing provenance_refresh_extractor.py constructs an idle
# Groq() client at import time (never actually called by this pipeline; no
# Tier here uses Groq), so this can be left blank without breaking anything.
GROQ_API_KEY=

# Optional — used by specialized_source_handlers.py's GitHub-tree handler to
# raise the unauthenticated GitHub API's 60 req/hr rate limit. Works fine
# without it for normal volumes.
GITHUB_TOKEN=
